PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/Dashboard
JWT_SECRET=generate_a_random_secret_at_least_32_characters_long
ADMIN_EMAILS=admin@example.com
SUPERADMIN_EMAILS=owner@example.com
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-private-profile-photo-bucket
PROFILE_TEST_API=true
# Use an IAM role or configure AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY securely.
# Optional for S3-compatible storage providers:
# S3_ENDPOINT=https://your-s3-compatible-endpoint
